# OpenAI API Key - Required for GPT-4 Vision, Whisper, and TTS
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Origin (React frontend URL)
CORS_ORIGIN=http://localhost:5173

# Neural Network Configuration
GPT_MODEL=gpt-4o
WHISPER_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=nova

# Vision Processing
VISION_ANALYSIS_INTERVAL=2000
MAX_FRAME_HISTORY=10

# Audio Processing
AUDIO_SILENCE_THRESHOLD=0.01
MAX_AUDIO_DURATION=30
